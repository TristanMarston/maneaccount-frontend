generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? 
  access_token      String? 
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? 
  session_state     String?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  braider
  subcontractor
  client
  admin
}

model Service {
  id           String   @id @default(cuid())
  userId       String
  name         String
  category     String
  priceUSD     Float
  duration     Int?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobAssignments JobAssignment[]
}

model Horse {
  id                String   @id @default(cuid())
  userId            String
  showName          String
  barnName          String
  gender            Gender?
  color             String? 
  profileImage      String?
  notes             String? 
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobAssignments    JobAssignment[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum Gender {
  mare
  gelding
  stallion
  filly
  colt
}

model Connection {
  id          String              @id @default(cuid())
  senderId    String    
  receiverId  String    
  status      ConnectionStatus    @default(pending)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  sender      User                @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User                @relation("receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
}

enum ConnectionStatus {
  pending
  accepted
}

enum ZelleOption {
  email
  phone
  link
  disabled
}

model User {
  id              String    @id @default(cuid())
  publicID        String?   @unique
  name            String?
  email           String?   @unique
  emailVerified   DateTime?
  phoneNumber     String?
  image           String?
  password        String?
  
  venmo           String?
  venmoEnabled    Boolean @default(false)
  zelle           String?
  zelleEnabled    ZelleOption @default(disabled)

  role            Role      @default(braider)
  services        Service[]
  horses          Horse[]
  shows           Show[]

  sentConnections     Connection[] @relation("sender")
  receivedConnections Connection[] @relation("receiver")

  createdAt       DateTime  @default(now())
  accounts        Account[]
  sessions        Session[]
  
  clientJobs        Job[] @relation("ClientJobs")
  braiderJobs       Job[] @relation("BraiderJobs")
  subcontractorJobs Job[] @relation("SubcontractorJobs")
  notes             Note[]
  
  sentShowInvites      ShowInvite[] @relation("ShowInviter")
  receivedShowInvites  ShowInvite[] @relation("ShowInvitee")
}

model Show {
  id          String    @id @default(cuid())
  userId      String
  name        String
  
  country     String
  state       String?
  city        String

  startDate   DateTime
  endDate     DateTime
  
  days        ShowDay[]
  invites     ShowInvite[]

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs        Job[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum ShowInviteStatus {
  pending
  accepted
  declined
}

model ShowInvite {
  id          String            @id @default(cuid())
  showId      String
  inviterId   String
  inviteeId   String
  status      ShowInviteStatus  @default(pending)
  
  show        Show              @relation(fields: [showId], references: [id], onDelete: Cascade)
  inviter     User              @relation("ShowInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee     User              @relation("ShowInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  
  @@unique([showId, inviteeId])
}

model ShowDay {
  id                 String   @id @default(cuid())
  showId             String
  date               DateTime
  startTime          String   
  endTime            String   
  skipped            Boolean  @default(false)
  googleEventId      String?

  show      Show     @relation(fields: [showId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Job {
  id              String    @id @default(cuid())
  clientId        String
  braiderId       String
  subcontractorId String?
  showId          String
  
  status          JobStatus @default(pending)
  
  scheduledStartTime DateTime?
  scheduledEndTime   DateTime?

  paidAt             DateTime?
  paymentPlatform    String?
  
  assignments     JobAssignment[]
  notes           Note[]
  
  client          User      @relation("ClientJobs", fields: [clientId], references: [id], onDelete: Cascade)
  braider         User      @relation("BraiderJobs", fields: [braiderId], references: [id], onDelete: Cascade)
  subcontractor   User?     @relation("SubcontractorJobs", fields: [subcontractorId], references: [id])
  show            Show      @relation(fields: [showId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Note {
  id        String   @id @default(cuid())
  jobId     String
  authorId  String
  content   String
  
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
}

enum JobStatus {
  pending
  accepted
  denied
  canceled
  delegated
  sub_requested
  sub_declined
  completed
}

model JobAssignment {
  id        String   @id @default(cuid())
  jobId     String
  horseId   String
  
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  horse     Horse    @relation(fields: [horseId], references: [id], onDelete: Cascade)
  services  Service[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

